TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ALLOWED_TELEGRAM_IDS=123456789
OPENAI_API_KEY=

# OpenAI models (change to GPT-5 family if your account has access)
# Chat: coaching, setbacks, deep analysis, long messages
OPENAI_CHAT_MODEL=gpt-4o
# Fast: nudges, memory extraction, summaries, short chat
OPENAI_FAST_MODEL=gpt-4o-mini
# Vision: food photo analysis (/yemek) — must support images
OPENAI_VISION_MODEL=gpt-4o
# Embeddings: memory search
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# GPT-5 example (when available on your key):
# OPENAI_CHAT_MODEL=gpt-5.4
# OPENAI_FAST_MODEL=gpt-5.4-mini
# OPENAI_VISION_MODEL=gpt-5.4

DATABASE_URL=postgresql+asyncpg://tbot:tbot@postgres:5432/tbot
REDIS_URL=redis://redis:6379/0
API_KEY=change-me
ENV=development
DASHBOARD_ORIGIN=http://localhost:5173
USER_TIMEZONE=Europe/Istanbul
CHECKIN_NUDGE_HOUR=8
PROACTIVE_OUTREACH_ENABLED=true
MAX_DAILY_NUDGES=3
MIN_HOURS_BETWEEN_NUDGES=3
OUTREACH_EVAL_INTERVAL_MINUTES=30
CHAT_SESSION_TTL_MINUTES=45
WEBHOOK_BASE_URL=https://your-domain.com
PHOTO_STORAGE_PATH=./data/photos
PROMPT_VERSION=1
MAX_DAILY_VISION_CALLS=20
DAILY_CALORIE_SOFT_LIMIT=2200
MAX_MEALS_BEFORE_NUDGE=4
CHAT_HISTORY_TOKEN_BUDGET=2500
MEMORY_RETRIEVAL_LIMIT=15
EPISODIC_DAYS=30
CONVERSATION_RETENTION_DAYS=90
PHOTO_RETENTION_DAYS=30
MEMORY_DECAY_ENABLED=true
SENTRY_DSN=
ASYNC_WEBHOOK=true
MAX_DAILY_ANALYSIS=2
DEBUG=false
